{
  "packageFormat": "syllabai-content-package",
  "packageVersion": "0.1",
  "scope": "bounded-proof",
  "buildId": "REPLACE_WITH_BUILD_ID",
  "compilerVersion": "REPLACE_WITH_COMPILER_VERSION",
  "schemaVersion": "0.1",
  "createdAt": "REPLACE_WITH_ISO_8601_TIMESTAMP",
