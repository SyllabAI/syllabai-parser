    },
    {
      "path": "content/papers/<paper-id>/mark-scheme.md",
      "type": "mark_scheme_markdown",
      "sha256": "REQUIRED"
    },
    {
      "path": "database/content.sqlite",
      "type": "sqlite_database",
      "sha256": "REQUIRED"
    }
  ]
